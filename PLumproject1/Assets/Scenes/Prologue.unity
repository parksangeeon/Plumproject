  lines:
  - "\"\uADF8\uB294 \uBAA8\uB450\uAC00 \uBBFF\uACE0 \uB530\uB974\uB358 \uC758\uC0AC\uC600\uB2E4.\","
  - "\"\uC5B8\uB860\uC740 \uADF8\uB97C '\uAE30\uC801\uC744 \uB9CC\uB4DC\uB294 \uB0A8\uC790'\uB77C
    \uBD88\uB800\uB2E4.\","
  - "\"\uADF8\uB7EC\uB358 \uC5B4\uB290 \uB0A0, \uD55C \uC0AC\uAC74\uC774 \uC77C\uC5B4\uB0AC\uB2E4.\","
  - "\"\uD658\uC790 \uC0AC\uB9DD\u2026 \uC720\uBA85 \uC678\uACFC\uC758, \uC758\uB8CC\uC0AC\uACE0\uB85C
    \uBA74\uD5C8 \uBC15\uD0C8\","
  - "\"\uADF8 \uD6C4, \uADF8\uB294 \uC790\uCDE8\uB97C \uAC10\uCDC4\uB2E4.\","
  - "\"...\uD558\uC9C0\uB9CC, \uADF8\uAC8C \uC804\uBD80\uB294 \uC544\uB2C8\uC5C8\uB2E4.\","
  - "\r\"\uADF8\uB294 \uC0AC\uB77C\uC9C4 \uAC8C \uC544\uB2C8\uB77C, \uBCD1\uC6D0\uC5D0
    \uB3CC\uC544\uC628 \uAC83\uC774\uC5C8\uB2E4.\",\n"
  - "\"\uB2E4\uB9CC, \uC758\uC0AC\uB85C\uC11C\uAC00 \uC544\uB2C8\uB77C...\","
  - "\"\uC545\uBABD\uC758 \uC2DC\uC791\uC774\uC5C8\uB2E4.\""
  typingSpeed: 0.05
